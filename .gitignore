# Godot 4+ specific ignores
.godot/
/android/

# Art source assets — never referenced by Godot directly
art/**/*.import

# GUT testing addon — install from Godot AssetLib (search "GUT - Godot Unit Testing")
# or download from https://github.com/bitwes/Gut (minimum version: 9.6.0 for Godot 4.6)
addons/gut/

# Claude Code agent memory (local to each developer's machine)
.claude/agent-memory
.claude/worktrees

# godot-testing plugin — Python MCP server venv (auto-created on first run)
plugins/godot-testing/server/.venv/

# VS Code
.vscode/

# macOS
.DS_Store
