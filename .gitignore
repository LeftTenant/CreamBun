# Godot 4+ specific ignores
.godot/
/android/

# Art source assets — never referenced by Godot directly
art/**/*.import

# GUT testing addon — install from Godot AssetLib (search "GUT - Godot Unit Testing")
# or download from https://github.com/bitwes/Gut (minimum version: 9.6.0 for Godot 4.6)
addons/gut/

# Transient test artifacts written by the godot-testing plugin: full GUT logs,
# rendered Markdown reports, JUnit XML, and transient e2e screenshots. Inspect
# locally; never commit. (Committed e2e baselines live under tests/e2e/.)
.godot-test-reports/

# Per-developer agent memory overlay (personal profiles, machine-specific paths)
.claude/agent-memory-local

# Claude Code worktrees (per-developer scratch space)
.claude/worktrees

# godot-testing plugin — Python MCP server venv (auto-created on first run)
plugins/godot-testing/server/.venv/
# godot-testing plugin — per-machine config (Godot binary path, auto-created)
plugins/godot-testing/server/.config.json
# Python bytecode cache
__pycache__/
*.pyc

# VS Code
.vscode/

# macOS
.DS_Store
