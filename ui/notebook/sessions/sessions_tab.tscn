[gd_scene format=3]

[ext_resource type="Script" path="res://ui/notebook/sessions/sessions_tab.gd" id="1"]

; EDITOR-PREVIEW NOTE
; -------------------
; The notebook creates this tab with SessionsTab.new() (see notebook.gd) and the
; controller re-anchors / rebuilds the page subtrees at runtime, so the layout
; values below are PREVIEW ONLY — they make the scene legible in the editor and
; do not affect the running game:
;   * The root size and the LeftPage/RightPage offsets are overwritten by
;     populate_left()/populate_right() (PRESET_FULL_RECT + 8px insets — see NotebookTab.PAGE_INSET).
;   * CardsContainer children (StoryCard instances) are added dynamically by
;     populate_left(); the container is empty in editor preview.
;   * SaveButton (Slice 6) triggers SessionsTab._on_save_pressed(), wired in
;     populate_left() -> SaveManager.save_slot("default").
;   * RightPage's Placeholder text is the entire right-page story for Phase 1;
;     no dynamic content is added (D2: right page is purely static).
; custom_minimum_size is set on the Placeholder Label both to silence Godot's
; "Labels with autowrapping enabled must have a custom minimum size" warning and
; to give it a sensible preview width.
;
; SCROLL NOTE: CardsContainer is wrapped in a SessionsScroll ScrollContainer so
; a long list of story cards scrolls rather than overflowing the page boundary
; (ui/CLAUDE.md rule 3). SaveButton sits outside the scroll so it is always
; reachable. sessions_tab.gd resolves CardsContainer via
; "SessionsScroll/CardsContainer".

[node name="SessionsTab" type="Control"]
offset_right = 480.0
offset_bottom = 300.0
script = ExtResource("1")

[node name="LeftPage" type="VBoxContainer" parent="."]
offset_left = 10.0
offset_top = 10.0
offset_right = 230.0
offset_bottom = 290.0
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="SessionsScroll" type="ScrollContainer" parent="LeftPage"]
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0
vertical_scroll_mode = 3

[node name="CardsContainer" type="VBoxContainer" parent="LeftPage/SessionsScroll"]
size_flags_horizontal = 3

[node name="SaveButton" type="Button" parent="LeftPage"]
size_flags_horizontal = 3
text = "Save"
tooltip_text = "Save the current story to the default slot"

[node name="RightPage" type="VBoxContainer" parent="."]
offset_left = 250.0
offset_top = 10.0
offset_right = 470.0
offset_bottom = 290.0
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Placeholder" type="Label" parent="RightPage"]
custom_minimum_size = Vector2(200, 0)
focus_mode = 0
size_flags_horizontal = 3
autowrap_mode = 3
text = "Select a Story to see details."
